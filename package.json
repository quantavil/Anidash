{
	"name": "anidash",
	"private": true,
	"version": "0.1.1",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "NODE_OPTIONS=--no-deprecation svelte-kit sync || echo ''",
		"check": "NODE_OPTIONS=--no-deprecation svelte-kit sync && NODE_OPTIONS=--no-deprecation svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "NODE_OPTIONS=--no-deprecation svelte-kit sync && NODE_OPTIONS=--no-deprecation svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260921.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.2",
		"eslint": "^10.11.0",
		"eslint-config-flat-gitignore": "^2.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"wrangler": "~4.136.1"
	},
	"dependencies": {
		"@fontsource-variable/outfit": "^5.3.0",
		"idb": "^8.0.3",
		"lucide-svelte": "^1.0.1",
		"svelte-sonner": "^1.2.1",
		"zod": "^4.6.5"
	}
}
