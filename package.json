{
	"name": "anidash",
	"private": true,
	"version": "0.1.3",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "NODE_OPTIONS=--no-deprecation svelte-kit sync || echo ''",
		"check": "NODE_OPTIONS=--no-deprecation svelte-kit sync && NODE_OPTIONS=--no-deprecation svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "NODE_OPTIONS=--no-deprecation svelte-kit sync && NODE_OPTIONS=--no-deprecation svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxfmt --check && oxlint",
		"format": "oxfmt",
		"test": "vitest run",
		"knip": "knip"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261109.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.6",
		"eslint-plugin-svelte": "^3.24.1",
		"jsdom": "^31.0.0",
		"knip": "^6.44.2",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "~6",
		"vite": "^8.3.7",
		"vitest": "^5.1.0",
		"wrangler": "~4.159.0"
	},
	"dependencies": {
		"@fontsource-variable/outfit": "^5.3.0",
		"idb": "^8.0.4",
		"lucide-svelte": "^1.0.1",
		"svelte-sonner": "^1.2.3",
		"zod": "^4.6.7"
	},
	"packageManager": "bun@1.4.2"
}
