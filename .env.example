# Public MAL client ID, baked into the browser bundle (also set in wrangler.toml [vars]).
VITE_MAL_CLIENT_ID=your_mal_client_id

# Server-side values live elsewhere, never in .env:
#   MAL_CLIENT_ID      -> wrangler.toml [vars]
#   MAL_CLIENT_SECRET  -> .dev.vars locally, a Cloudflare *Secret* in production
